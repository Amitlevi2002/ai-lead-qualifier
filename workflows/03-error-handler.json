{
  "id": "aiLeadErrors0001",
  "name": "AI Lead Qualifier — Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "9874c44d-c779-467a-ad9f-cd5567a1216d",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the Error Trigger payload (execution errors and trigger errors look different).\nconst e = $json;\nconst exec = e.execution ?? {};\nconst err = exec.error ?? e.trigger?.error ?? {};\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow: e.workflow?.name ?? 'unknown',\n    workflow_id: e.workflow?.id ?? '',\n    node: exec.lastNodeExecuted ?? err.node?.name ?? '',\n    error: String(err.message ?? 'Unknown error').slice(0, 500),\n    execution_id: exec.id ?? '',\n    execution_url: exec.url ?? '',\n    mode: exec.mode ?? e.trigger?.mode ?? '',\n  },\n};\n"
      },
      "id": "f35526a2-23e8-48b9-b613-d0cd2d982aca",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
