        "jsCode": "// Validate Claude's reply. Anything unexpected -> valid: false (retry, then error flow).\nconst ATTEMPT = 2;\nconst lead = $('Build Retry Request').item.json.lead;\nconst res = $json;\n\nconst QUALITY = ['hot', 'warm', 'irrelevant'];\nconst URGENCY = ['high', 'medium', 'low', 'none'];\nconst LANGUAGE = ['he', 'en'];\n\nfunction validate(o) {\n  if (!o || typeof o !== 'object' || Array.isArray(o)) throw new Error('not a JSON object');\n  if (!QUALITY.includes(o.quality)) throw new Error('bad quality: ' + o.quality);\n  const x = o.extracted;\n  if (!x || typeof x !== 'object') throw new Error('missing extracted');\n  if (typeof x.interest_area !== 'string' || !x.interest_area.trim()) throw new Error('bad interest_area');\n  if (!URGENCY.includes(x.urgency)) throw new Error('bad urgency: ' + x.urgency);\n  if (!LANGUAGE.includes(x.language)) throw new Error('bad language: ' + x.language);\n  if (typeof o.reason !== 'string' || !o.reason.trim()) throw new Error('missing reason');\n  return {\n    quality: o.quality,\n    interest_area: x.interest_area.trim().slice(0, 60),\n    urgency: x.urgency,\n    language: x.language,\n    reason: o.reason.trim().slice(0, 300),\n  };\n}\n\nlet classification = null;\nlet parse_error = null;\nlet raw_text = '';\ntry {\n  if (res.stop_reason === 'refusal') throw new Error('model refused (' + (res.stop_details?.category ?? 'unknown') + ')');\n  if (res.stop_reason === 'max_tokens') throw new Error('reply truncated at max_tokens');\n  const text = (res.content ?? []).find((b) => b.type === 'text');\n  if (!text) throw new Error('no text block in reply');\n  raw_text = text.text;\n  // Tolerate a stray markdown fence even though we asked for raw JSON.\n  const cleaned = raw_text.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n  classification = validate(JSON.parse(cleaned));\n} catch (e) {\n  parse_error = e.message;\n}\n\nreturn {\n  json: {\n    lead,\n    classification,\n    valid: parse_error