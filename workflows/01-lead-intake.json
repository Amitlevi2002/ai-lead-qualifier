        "jsCode": "// Second (and last) attempt: same request plus a note about what failed.\nconst prev = $('Build Claude Request').item.json;\nconst req = JSON.parse(JSON.stringify(prev.claude_request)); // structuredClone isn't available in the Code node sandbox\nreq.messages[0].content +=\n  '\\n\\nA previous answer failed validation (' + $json.parse_error + '). ' +\n  'Return only the JSON object that matches the schema.';\nreturn { json: { lead: prev.lead, claude_request: req } };\n"
