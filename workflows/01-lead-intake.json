    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalise and validate the webhook payload. Never trust client input.\nconst b = $json.body ?? {};\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst SOURCES = ['google', 'facebook', 'website', 'portal'];\n\nconst rawSource = str(b.source).toLowerCase();\nconst now = new Date();\n\nconst lead = {\n  lead_id: 'L-' + now.getTime().toString(36) + '-' + Math.random().toString(36).slice(2, 7),\n  received_at: now.toISOString(),\n  received_date: now.toLocaleDateString('en-CA', { timeZone: 'Asia/Jerusalem' }), // YYYY-MM-DD\n  name: str(b.name).slice(0, 100),\n  phone: str(b.phone).slice(0, 30),\n  email: str(b.email).toLowerCase().slice(0, 150),\n  source: rawSource || 'website',\n  message: str(b.message).slice(0, 2000),\n};\n\nconst errors = [];\nif (!lead.name) errors.push('name is required');\nif (!lead.phone && !lead.email) errors.push('phone or email is required');\nif (lead.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) errors.push('email is invalid');\nif (lead.phone && lead.phone.replace(/\\D/g, '').length < 9) errors.push('phone is invalid');\nif (!lead.message) errors.push('message is required');\nif (!SOURCES.includes(lead.source)) errors.push('source must be one of: ' + SOURCES.join(', '));\nif (str(b.website)) errors.push('rejected'); // honeypot field filled in -> bot\n\nreturn { json: { valid: errors.length === 0, errors, lead } };\n"
      },
