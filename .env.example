# ─────────────────────────────────────────────────────────────
# AI Lead Qualifier — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# n8n image version (pinned so exported workflows import cleanly)
N8N_VERSION=2.8.4

# Encrypts credentials stored inside n8n. Generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you lose it, every saved credential becomes unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Public base URL n8n uses when it prints webhook URLs.
# Local: http://localhost:5678/   Railway: https://<your-app>.up.railway.app/
WEBHOOK_URL=http://localhost:5678/

TIMEZONE=Asia/Jerusalem

# ── Basic auth in front of the n8n editor (Caddy reverse proxy) ──
# n8n 1.0+ removed its built-in basic auth, so Caddy guards the editor.
# Webhook paths (/webhook/*) stay open so the landing page can POST leads.
# Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes — the bcrypt hash contains "$" characters.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$replace.with.your.bcrypt.hash.from.caddy.hash-password'

# ── Workflow config (non-secret, read via $env in n8n expressions) ──
# Claude model used by the classifier node
CLAUDE_MODEL=claude-sonnet-5-5

# ── Demo mode (no API key, no cost) ──
# Start with:  docker compose --profile demo up -d
# and point the classifier at the keyword-based mock:
CLAUDE_API_URL=http://mock-claude:8787/v1/messages
# Leave CLAUDE_API_URL empty to call the real Claude API.
# Share of mock replies that are deliberately not JSON (0-1) — shows the retry + error flow
MOCK_BAD_JSON_RATE=0

# Google Sheet ID (the long part of the sheet URL between /d/ and /edit)
# The sheet needs three tabs: Leads, Rejected, Errors
GOOGLE_SHEET_ID=your-google-sheet-id

# Telegram chat that receives hot/warm alerts, the daily summary and error alerts
TELEGRAM_CHAT_ID=123456789

# Daily summary email
SUMMARY_EMAIL_TO=you@example.com
SUMMARY_EMAIL_FROM=n8n-bot@example.com

# ── Secrets that live in n8n credentials, NOT here ──
# Anthropic API key  -> n8n credential "Header Auth"  (name: x-api-key)
# Telegram bot token -> n8n credential "Telegram API"
# Google Sheets      -> n8n credential "Google Sheets OAuth2 API"
# SMTP               -> n8n credential "SMTP"
